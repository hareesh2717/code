%%[
VAR @rows, @row, @rowCount
VAR @subjectLine, @preheader, @headerLogo, @heroImage, @body, @callout
SET @PlanState = AttributeValue("PlanState")
SET @BrandAbbreviation = AttributeValue("BrandAbbreviation")
SET @VAR016 = AttributeValue("VAR016")
SET @PlanState = AttributeValue("PlanState")
SET @BrandAbbreviation = AttributeValue("BrandAbbreviation")
SET @VAR016 = AttributeValue("VAR016")



SET @rows = LookupRows(
    "state_learn",
    "PlanState", @PlanState,
    "BrandAbbreviation", @BrandAbbreviation,
    "VAR016", @VAR016
)

SET @rowCount = RowCount(@rows)

IF @rowCount > 0 THEN

    SET @row = Row(@rows, 1)

    SET @subjectLine = Field(@row, "subjectLine")
    SET @preheader   = Field(@row, "Preheader")
    SET @headerLogo  = Field(@row, "HeaderLogo")
    SET @heroImage   = Field(@row, "HeroImage")
    SET @body        = Field(@row, "Body")
    SET @callout     = Field(@row, "Callout")

ENDIF
]%%
